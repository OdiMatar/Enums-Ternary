{
  "expo": {
    "name": "Weerwijs",
    "slug": "weerwijs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/weerwijs-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#183b38",
        "foregroundImage": "./assets/weerwijs-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/weerwijs-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "weerwijs"
  }
}
